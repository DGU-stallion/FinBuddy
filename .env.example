# FinBuddy 环境变量模板
#
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，真实 key 绝不入库。

# ---- 主推理模型（DeepSeek V4.1-Flash，OpenAI 兼容接口）----
DEEPSEEK_API_KEY=
# 可选：自建/代理网关地址。留空则用官方地址 https://api.deepseek.com
# 注意：不要用 BASE_URL 作变量名 —— Vite 会把它设为 '/'，导致集成测试探活失败。
DEEPSEEK_BASE_URL=

# ---- 扶摇 MCP：行情快照 / 估值 / 利润表 / 财务指标 ----
# 端点 https://fuyao.aicubes.cn/mcp/a-share，认证头 X-api-key
FUYAO_API_KEY=

# ---- 同花顺 iFinD：公告与新闻语义检索 ----
IFIND_MCP_KEY=

# ---- 集成测试用（可选）----
# 集成测试打的地址，默认 http://127.0.0.1:3000
# FINBUDDY_BASE_URL=http://127.0.0.1:3000
