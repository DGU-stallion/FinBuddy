# 部署脚本的本地配置模板
#
# 复制为 deploy/.env.deploy 并填入你的值：
#   cp deploy/.env.deploy.example deploy/.env.deploy
#
# deploy/.env.deploy 已被 .gitignore 忽略（见文件末尾说明），不会入库。
# 这里**不要**放密钥 —— 4 个 API key 由 deploy.sh 从仓库根目录的 .env 读取并投递。

# 服务器 SSH 别名，对应 ~/.ssh/config 里的 Host 名
# 例：~/.ssh/config 里写了 `Host finbuddy`，这里就填 finbuddy
FINBUDDY_SSH_HOST=finbuddy

# 服务器上的应用目录
FINBUDDY_REMOTE_DIR=/opt/finbuddy

# 应用监听端口（Nginx 反代目标；勿改成 3000，原因见 deploy/README.md）
FINBUDDY_APP_PORT=3001
